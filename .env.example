# ─────────────────────────────────────────────────────────────
# DE-VPP — biến môi trường (sao chép sang .env để chạy local)
# Giá trị mặc định phù hợp môi trường DEMO. ĐỔI khi lên môi trường thật.
# ─────────────────────────────────────────────────────────────

# --- Chung ---
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- API ---
API_PORT=3000
# CORS: origin của web (demo dùng cổng 8080)
WEB_ORIGIN=http://localhost:8080
# URL công khai của app (dùng cho redirect OIDC)
APP_BASE_URL=http://localhost:8080

# --- Database (PostgreSQL) ---
# Dev local: Postgres của deploy/docker-compose.dev.yml, publish ra cổng 5433
# (tránh đụng Postgres khác đang chiếm 5432). Trong Docker demo: postgres:5432.
DATABASE_URL=postgres://vpp:vpp@localhost:5433/vpp

# --- Xác thực PMH ID SSO (OIDC BFF) ---
# Demo: trỏ vào mock-idp (deploy/mock-idp, chạy ở cổng 9000).
# Prod: đổi sang PMH ID thật do admin PMH ID cấp — KHÔNG phải sửa code.
OIDC_ISSUER=http://localhost:9000/oidc
# URL nội bộ tới IdP cho lệnh gọi server→server (token/jwks). Chỉ cần khi api KHÔNG
# tới được OIDC_ISSUER bằng chính URL đó — điển hình là api chạy trong Docker còn
# issuer là địa chỉ localhost của trình duyệt. Chạy trên máy thì để trống.
OIDC_INTERNAL_ISSUER=
PMH_CLIENT_ID=de-vpp-dev
PMH_CLIENT_SECRET=dev-secret-change-me
PMH_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Client M2M cho Directory API (đồng bộ danh bạ — dùng ở M2)
PMH_M2M_CLIENT_ID=de-vpp-dev-m2m
PMH_M2M_CLIENT_SECRET=dev-m2m-secret-change-me

# --- mock-idp (CHỈ demo/dev) ---
MOCK_IDP_PORT=9000
# Group PMH ID quyết định quyền admin của VPP
VPP_ADMIN_GROUP=VPP-Admin
# (tuỳ chọn) Group được coi là phòng ban, theo THỨ TỰ ưu tiên khi user thuộc nhiều group.
# Bỏ trống => lấy group đầu tiên khác VPP_ADMIN_GROUP.
VPP_DEPARTMENT_GROUPS=Hành chính,Nhân sự,Kế toán,Kỹ thuật,Kinh doanh

# --- Phiên đăng nhập ---
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_DAYS=7

# --- Lưu ảnh đính kèm (mục "Khác") ---
UPLOAD_DIR=./uploads
