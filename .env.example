# ─────────────────────────────────────────────────────────────
# DE-VPP — biến môi trường (sao chép sang .env để chạy local)
# Giá trị mặc định phù hợp môi trường DEMO. ĐỔI khi lên môi trường thật.
# ─────────────────────────────────────────────────────────────

# --- Chung ---
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- API ---
API_PORT=3000
# CORS: origin của web
WEB_ORIGIN=http://localhost:8090
# URL công khai của app (dùng cho redirect OIDC)
APP_BASE_URL=http://localhost:8090

# --- Database (PostgreSQL) ---
# Dev local: Postgres của deploy/docker-compose.yml, publish ra cổng 5433
# (tránh đụng Postgres khác đang chiếm 5432). Trong Docker demo: postgres:5432.
DATABASE_URL=postgres://vpp:vpp@localhost:5433/vpp

# --- Xác thực PMH ID SSO (OIDC BFF) ---
# Demo: trỏ vào mock-idp (deploy/mock-idp, chạy ở cổng 9000).
# Prod: đổi sang PMH ID thật do admin PMH ID cấp — KHÔNG phải sửa code.
OIDC_ISSUER=http://localhost:9000/oidc
# URL nội bộ tới IdP cho lệnh gọi server→server (token/jwks). Chỉ cần khi api KHÔNG
# tới được OIDC_ISSUER bằng chính URL đó — điển hình là api chạy trong Docker còn
# issuer là địa chỉ localhost của trình duyệt. Chạy trên máy thì để trống.
OIDC_INTERNAL_ISSUER=
# URL IdP đẩy về sau khi đăng xuất toàn hệ. Bỏ trống ⇒ dùng APP_BASE_URL + '/'.
# Đặt `off` khi IdP CHƯA đăng ký URL này: IdP từ chối cả lượt đăng xuất nếu nhận
# một post_logout_redirect_uri lạ, người dùng mắc ở trang lỗi của IdP. Đặt `off`
# thì vẫn đăng xuất được, chỉ là không tự quay về app.
OIDC_POST_LOGOUT_REDIRECT=
PMH_CLIENT_ID=de-vpp-dev
PMH_CLIENT_SECRET=dev-secret-change-me
PMH_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Client M2M cho Directory API (đồng bộ danh bạ — dùng ở M2)
PMH_M2M_CLIENT_ID=de-vpp-dev-m2m
PMH_M2M_CLIENT_SECRET=dev-m2m-secret-change-me

# ── Trỏ vào PMH ID THẬT (thay cho mock-idp) ─────────────────────────────────
# Thay 5 dòng bên trên bằng cấu hình dưới đây, KHÔNG phải sửa code:
#
#   OIDC_ISSUER=https://de-admin.pmh.com.vn:8443/oidc
#   PMH_CLIENT_ID=<admin PMH ID cấp>
#   PMH_CLIENT_SECRET=<admin PMH ID cấp — chỉ hiện MỘT LẦN>
#   PMH_WEBHOOK_SECRET=<admin PMH ID cấp>
#   PMH_M2M_CLIENT_ID=<admin PMH ID cấp>
#   PMH_M2M_CLIENT_SECRET=<admin PMH ID cấp>
#
# PMH_DIRECTORY_URL để trống: app tự suy ra `https://de-admin.pmh.com.vn:8443`
# từ issuer, đúng chỗ Directory API nằm (`/api/v1/...`).
#
# Bốn URL phải khai với admin PMH ID và KHỚP TỪNG KÝ TỰ với APP_BASE_URL ở trên:
#   redirect_uri            <APP_BASE_URL>/api/auth/callback
#   post_logout_redirect    <APP_BASE_URL>/
#   webhook_url             <APP_BASE_URL>/api/webhooks/pmh-id
#   backchannel_logout_uri  <APP_BASE_URL>/api/auth/backchannel-logout
#
# Kiểm trước khi khởi động app:  pnpm check:pmh-id
# ─────────────────────────────────────────────────────────────────────────────

# --- mock-idp (CHỈ demo/dev) ---
MOCK_IDP_PORT=9000
# Group PMH ID quyết định quyền admin của VPP
VPP_ADMIN_GROUP=VPP-Admin
# (tuỳ chọn) Group được coi là phòng ban, theo THỨ TỰ ưu tiên khi user thuộc nhiều group.
# Bỏ trống => lấy group đầu tiên khác VPP_ADMIN_GROUP.
VPP_DEPARTMENT_GROUPS=Hành chính,Nhân sự,Kế toán,Kỹ thuật,Kinh doanh

# Đổi tên phòng ban PMH ID gửi trong claim `department` sang tên dùng trong VPP.
# Dạng `nguồn=đích`, nhiều cặp cách nhau bởi dấu phẩy. Đích RỖNG = bỏ giá trị đó
# (coi như IdP không gửi phòng ban, quay về suy từ groups).
#   VPP_DEPARTMENT_ALIASES=Dept_Test_VPP=Hành chính,Dept_KT=Kỹ thuật
# Cần vì claim `department` là chuỗi tự do do IdP quyết định, mà nó hiện thẳng cho
# người dùng ở màn duyệt đơn và báo cáo Excel.
VPP_DEPARTMENT_ALIASES=

# --- Phiên đăng nhập ---
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_DAYS=7

# --- Lưu ảnh đính kèm (mục "Khác") ---
UPLOAD_DIR=./uploads

# --- Web (Vite dev server) ---
# APP_BASE_URL phải trỏ vào origin NÀY: trình duyệt quay về đây sau khi đăng nhập,
# và Vite proxy /api sang backend giống nginx lúc chạy thật.
WEB_PORT=8090
WEB_API_PROXY=http://localhost:3000

# --- Dọn ảnh mồ côi (ảnh không còn bản ghi nào tham chiếu) ---
# Ảnh vừa tải lên mà form chưa gửi thì CHƯA phải rác — ân hạn để không xoá nhầm.
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_ORPHAN_GRACE_HOURS=24
UPLOAD_CLEANUP_HOURS=24
