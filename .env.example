# VPP Công trình — copy file này thành `.env` rồi đổi các giá trị CHANGE_ME (.env KHÔNG commit)

# --- Compose ---
# Chốt tên project để container luôn là 'vpp-*' (vd vpp-postgres-1) BẤT KỂ tên thư mục clone.
# Thiếu dòng này thì project = tên thư mục, container/volume đổi tên, script backup sẽ trật.
# ĐẶT TRƯỚC lần deploy đầu (đổi sau = volume mới, mất data).
COMPOSE_PROJECT_NAME=vpp

# --- Postgres ---
POSTGRES_USER=vpp
# LƯU Ý: password được nội suy vào DATABASE_URL — chỉ dùng chữ/số/-/_
# (ký tự @ / # % : sẽ phá URL kết nối)
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=vpp
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- App ---
# NODE_ENV: production | development | test
NODE_ENV=production
# AUTH_DEV_MODE chỉ nhận đúng chuỗi `true`/`false` (TRUE/1/yes = coi như tắt).
# =true CHỈ được phép khi NODE_ENV=development|test — sai môi trường là app TỪ CHỐI KHỞI ĐỘNG (fail-closed)
AUTH_DEV_MODE=false
# URL gốc app — dựng redirect_uri = {APP_BASE_URL}/api/auth/callback (khai với SA PMH ID)
APP_BASE_URL=https://de-vpp.pmh.com.vn:8443
# Số hop proxy tin cậy trước api: EDGE → web nginx = 2
TRUST_PROXY_HOPS=2

# --- PMH ID (SSO). Client DEV/PROD TÁCH RIÊNG, SA cấp ---
PMH_ISSUER_URL=https://de-admin.pmh.com.vn:8443/oidc
PMH_CLIENT_ID=project-vpp
PMH_CLIENT_SECRET=
PMH_WEBHOOK_SECRET=
# Lệch đồng hồ tối đa (giây) chấp nhận cho timestamp webhook PMH ID
WEBHOOK_TS_SKEW_SEC=300
# SA cục bộ (break-glass): tài khoản root độc lập SSO — CHỈ dùng để can thiệp/bootstrap.
# BẮT BUỘC — thiếu là app từ chối khởi động. SA CHỈ đến từ đây.
# Sinh hash: cd api && npm run sa:hash -- 'mật-khẩu-mạnh'  (KHÔNG lưu mật khẩu thô ở đâu cả)
LOCAL_SA_USERNAME=sa
LOCAL_SA_PASSWORD_HASH=
# Cert dev tự ký: đặt NODE_EXTRA_CA_CERTS=/path/ca.pem (KHÔNG tắt TLS verify)

# --- Ngân sách RAM (mem_limit từng service) ---
# Dev/máy nhỏ có thể giảm (vd postgres 512m / api 384m / web 64m).
POSTGRES_MEM_LIMIT=1024m
API_MEM_LIMIT=512m
WEB_MEM_LIMIT=128m

# --- Ảnh món ---
# Trong Docker: compose đã hardcode /data/files (volume filesdata) — KHÔNG cần đặt.
# Chỉ cần khi chạy api NGOÀI Docker (dev/test): trỏ thư mục ghi được bất kỳ.
# FILE_STORAGE_DIR=./data/files

# --- Backup (service backup-cron + restore, ops/backup) ---
# BACKUP_DIR = thư mục HOST chứa file backup (map vào /backups trong container).
# Bỏ trống = mặc định ./data-backups (trong repo). Prod nên trỏ ổ/thư mục riêng ngoài repo.
# Nhớ: mkdir -p thư mục đó + đủ quyền ghi trước lần deploy đầu.
BACKUP_DIR=/srv/vpp-backups
# Giờ chạy backup tự động hằng ngày (HH:MM, theo TZ=Asia/Bangkok trong container)
BACKUP_AT=02:00
# Giữ tịnh tiến bao nhiêu NGÀY (xóa bản cũ hơn)
BACKUP_KEEP_DAYS=30
# Mã hóa AES-256 bản backup (BẮT BUỘC theo mặc định). Sinh: openssl rand -hex 32
# ⚠️ Mất passphrase = KHÔNG restore được. Lưu nơi an toàn, KHÔNG đổi sau khi đã có bản backup.
# Fail-closed: để trống / còn placeholder / < 16 ký tự → backup TỪ CHỐI chạy (không ghi plaintext âm thầm).
BACKUP_PASSPHRASE=CHANGE_ME_openssl_rand_hex_32
# Cố ý muốn backup KHÔNG mã hóa (không khuyến nghị) → đặt =1 và để trống BACKUP_PASSPHRASE.
BACKUP_ALLOW_PLAINTEXT=0
