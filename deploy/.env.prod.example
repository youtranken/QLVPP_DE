# ─────────────────────────────────────────────────────────────────────────────
# DE-VPP — cấu hình PRODUCTION.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#
# ⚠️  KHÔNG commit `.env.prod` (đã có trong .gitignore).
# Ô đánh dấu [PMH ID] do **admin PMH ID cấp** — xem docs/operations/ONBOARDING-PMH-ID.md
# Ô đánh dấu [TỰ SINH] tự tạo bằng: openssl rand -base64 36
# ─────────────────────────────────────────────────────────────────────────────

# --- Địa chỉ công khai ---
# PHẢI là https: cookie phiên đặt `secure` ở production, chạy http thì trình duyệt
# bỏ cookie và không ai đăng nhập được. api từ chối khởi động nếu không phải https.
APP_BASE_URL=https://de-vpp.pmh.com.vn
# Cổng web nghe trên host (TLS do EDGE / reverse proxy đứng trước lo).
# Khi dùng overlay edge thì cổng này không còn được publish.
WEB_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=vpp
POSTGRES_DB=vpp
# [TỰ SINH]
POSTGRES_PASSWORD=

# --- PMH ID SSO ---
# [PMH ID] Issuer thật, vd https://de-admin.pmh.com.vn/oidc
OIDC_ISSUER=
# Chỉ đặt khi api KHÔNG tới được OIDC_ISSUER bằng chính URL đó — điển hình là
# chạy sau EDGE: api gọi PMH ID qua host-gateway. Để trống nếu tới thẳng được.
OIDC_INTERNAL_ISSUER=
# [PMH ID]
PMH_CLIENT_ID=
PMH_CLIENT_SECRET=
PMH_WEBHOOK_SECRET=
# [PMH ID] Client M2M cho Directory API (đồng bộ danh bạ)
PMH_M2M_CLIENT_ID=
PMH_M2M_CLIENT_SECRET=
# Để trống ⇒ suy từ issuer. Chỉ đặt khi Directory API nằm ở host khác.
PMH_DIRECTORY_URL=

# --- Phiên đăng nhập ---
# [TỰ SINH] Đổi giá trị này = đăng xuất toàn bộ người dùng.
SESSION_SECRET=
SESSION_TTL_DAYS=7

# --- Ánh xạ nhóm PMH ID ---
VPP_ADMIN_GROUP=VPP-Admin
# Thứ tự = độ ưu tiên khi một người thuộc nhiều nhóm phòng ban.
VPP_DEPARTMENT_GROUPS=Hành chính,Nhân sự,Kế toán,Kỹ thuật,Kinh doanh
DIRECTORY_SYNC_MINUTES=60

# --- Dọn ảnh mồ côi ---
# Ảnh không còn bản ghi nào tham chiếu (admin đổi/gỡ ảnh món, người dùng bỏ dở form)
# sẽ bị xoá sau thời gian ân hạn. Ân hạn để KHÔNG xoá ảnh của form đang mở dở.
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_ORPHAN_GRACE_HOURS=24
UPLOAD_CLEANUP_HOURS=24

# --- Thương hiệu ---
# In lên đầu báo cáo Excel trình ký. api từ chối khởi động nếu còn là "CÔNG TY".
ORG_NAME=CÔNG TY CỔ PHẦN PMH

# --- Phiên bản image (tuỳ chọn) ---
# Đặt tag cụ thể để triển khai lại đúng phiên bản đã kiểm thử, vd 2026.08.13
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# CHỈ khi chạy sau EDGE (dùng thêm deploy/docker-compose.edge.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Alias RIÊNG của DE-VPP trên mạng edge — không được trùng dự án khác.
EDGE_ALIAS=vpp-web
# Tên mạng edge có sẵn trên máy chủ.
EDGE_NETWORK=edge
# Hostname của PMH ID để api gọi qua host-gateway.
PMH_HOST=de-admin.pmh.com.vn

# ─────────────────────────────────────────────────────────────────────────────
# Lối thoát cho STAGING nội bộ chạy http (KHÔNG dùng cho hệ thống thật).
# Đặt =1 thì api vẫn chạy dù cấu hình chưa an toàn, nhưng in cảnh báo mỗi lần khởi động.
# ALLOW_INSECURE_PRODUCTION=1
