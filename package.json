{
  "name": "de-vpp",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống đăng ký văn phòng phẩm (VPP) — monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @vpp/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @vpp/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @vpp/web test:e2e",
    "smoke:api": "bash scripts/smoke-api.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
