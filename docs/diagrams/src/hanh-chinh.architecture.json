  },
  {
   "dot": "rose",
   "title": "Chuyển hướng (giữ query, thay mục lịch sử)",
   "items": [
    "/admin → /admin/today (ADMIN_HOME); /admin/home, /admin/summary → /admin/month; /admin/send-adm → /admin/reports; /admin/units → /admin/categories/units",
