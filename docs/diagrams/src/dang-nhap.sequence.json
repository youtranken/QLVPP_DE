 "cards": [
  {
   "dot": "emerald",
   "title": "SSO",
   "items": [
    "Callback lỗi → /?login=failed; access_denied hoặc thu hồi mới hơn iat → /?login=forbidden (VPP không có gate nhóm riêng)",
    "Cookie vpp_sid 256 bit, DB chỉ lưu sha256 (id_hash); phiên tối đa 12 h; refresh single-flight theo phiên"
   ]
  },
  {
   "dot": "amber",
   "title": "Tài khoản D&E (PMH ID) sập",
   "items": [
    "Không biến outage thành logout: phiên giữ, tự sống lại khi PMH ID về",
    "Route bảo vệ và auth/session trả 503 SSO_UNAVAILABLE; route @Public (sa-login, identify, public-config) chạy ẩn danh"
   ]
  },
  {
   "dot": "rose",
   "title": "SA break-glass",
   "items": [
    "sa-login và identify 10/phút/IP; lockout in-memory, restart api để xóa khóa toàn cục",
    "Phiên SA không refresh; idle quá 2 h → đăng nhập lại"
   ]
  }
 ]
