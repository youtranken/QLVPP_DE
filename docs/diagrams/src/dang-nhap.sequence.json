  "cards": [
    {
      "dot": "emerald",
      "title": "SSO",
      "items": [
        "Callback lỗi → /?login=failed; access_denied hoặc ngoài group → /?login=forbidden",
        "Refresh single-flight theo phiên (nhiều tab không đốt refresh token)"
      ]
    },
    {
      "dot": "amber",
      "title": "PMH ID sập",
      "items": [
        "Không biến outage thành logout: phiên giữ, tự sống lại khi PMH ID về",
        "Route bảo vệ 503; route @Public (sa-login, public-config) chạy ẩn danh"
      ]
    },
    {
      "dot": "rose",
      "title": "SA break-glass",
      "items": [
        "sa-login 10/phút/IP; lockout in-memory, restart api để xóa khóa toàn cục",
        "Phiên SA không refresh; idle quá 2 h → đăng nhập lại"
      ]
    }
  ]
