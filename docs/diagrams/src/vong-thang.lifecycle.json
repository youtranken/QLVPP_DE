  "cards": [
    {
      "dot": "cyan",
      "title": "Lịch chuông (cron mỗi giờ, phút 5 giờ VN)",
      "items": [
        "Ngày 1: period_open cho mẫu số Tổng hợp",
        "lastDay − 2 (còn 3 ngày): reminder cho người chưa có phiếu",
        "Ngày khóa (= lastDay + 1): period_locked cho Hành chính; headcount ghi bù nếu trượt",
        "Mỗi lần chạy: sắp hết kho (đòi quyền một lần), xóa chuông > 90 ngày"
      ]
    },
    {
      "dot": "amber",
      "title": "Còn nợ và báo cáo",
      "items": [
        "Chỉ giao/hủy nợ khi kỳ của phiếu đã khóa",
        "Phần còn lại = qty − đã giao − đã hủy; vào báo cáo kỳ sau dưới cột Nợ kỳ trước",
        "Cần mua = phần còn lại kỳ này + nợ kỳ trước − tồn (BR-15)",
        "Giao tất cả thiếu kho: dòng đó vào Còn nợ (STOCK_INSUFFICIENT), dòng khác vẫn giao",
        "Hủy nợ làm hết nợ nhưng không gửi chuông giao đủ",
        "Bản chốt chốt được cả kỳ đang mở; mỗi lần bấm Xuất/In một bản mới, In lại/Tải lại ra số cũ"
      ]
    },
    {
      "dot": "rose",
      "title": "Không có",
      "items": [
        "Hoàn tác đợt giao (FR-44 bỏ khỏi GĐ1)",
        "Gửi bù chuông khi cron trượt cả ngày (giả định 3)"
      ]
    }
