 "cards": [
  {
   "dot": "rose",
   "title": "Ranh giới tin cậy",
   "items": [
    "TLS kết thúc ở EDGE (repo PMH_IDE, cấu hình không nằm trong repo này)",
    "web chỉ join mạng edge, không publish cổng; nginx xóa header dev-identity",
    "TRUST_PROXY_HOPS = 2 (EDGE + web nginx) để req.ip là IP máy người dùng"
   ]
  },
  {
   "dot": "amber",
   "title": "PMH ID sập",
   "items": [
    "Refresh lỗi mạng → route bảo vệ 503 SSO_UNAVAILABLE, phiên được giữ",
    "Route @Public (sa-login, public-config, health) đi tiếp ẩn danh",
    "SA local là lối vào break-glass; lockout (IP, user) 5 sai, toàn cục 50"
   ]
  },
  {
   "dot": "cyan",
   "title": "Gộp trong sơ đồ",
   "items": [
    "auth · users: AuthModule import UsersModule (directory sync 60′ gọi Directory API)",
    "delivery ghi request_lines qua LineDeliveryStore, trừ tủ qua StockService; deliver-all đã gỡ",
    "reminders lúc khóa sổ: ghi headcount_subs, AdmOutSettlement hủy phần chưa giao của món ADM hết hàng mọi kỳ trước",
    "ConfigAdminModule tách khỏi SystemConfigModule (sửa cấu hình cần kỳ đang mở); audit được mọi module gọi"
   ]
  },
  {
   "dot": "violet",
   "title": "Bảng/cột mới Plan v2-D",
   "items": [
    "0113 request_line_adjustments (chỉ-thêm, trigger chặn UPDATE/DELETE/TRUNCATE) · 0114 period_adm_out (out · owed_closed)",
    "0115 stock_movements.receipt_ym · 0116 periods.headcount_subs · 0117 custom_receipts",
    "0118 periods.no_order_at/by · 0119 chỉ mục audit_log(detail->>'batch_id')"
   ]
  },
  {
   "dot": "emerald",
   "title": "Endpoint mới Plan v2-D",
   "items": [
    "admin/periods/:ym: arrivals-plan · adm-out/:line_key · adm-owed-closed/:line_key · custom-receipts · send-state · no-order",
    "GET admin/reports/:ym/sent · GET admin/stock · GET admin/items/:id/pending-arrival",
    "Đã gỡ: POST admin/requests (tạo phiếu hộ), POST admin/requests/:id/deliver-all, ?exclude_admin của admin/users"
   ]
  }
 ]
