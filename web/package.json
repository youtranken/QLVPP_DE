{
  "name": "vpp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-hardcoded-text.mjs && node scripts/check-css-scale.mjs && node scripts/check-css-balance.mjs && npm run -s test:nginx",
    "test:nginx": "node --test --test-reporter=dot ../ops/nginx-cache.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p playwright/tsconfig.json"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dialog": "^1.1.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "i18next": "~26.3.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "~26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "~31.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.3",
    "vite": "~8.3.8",
    "vitest": "~5.1.0"
  }
}
